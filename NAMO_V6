RS.Heartbeat:Connect(function()pcall(function()
    local c=LP.Character;if not c then return end
    local hm=c:FindFirstChildOfClass("Humanoid");local hr=c:FindFirstChild("HumanoidRootPart")
    if S.Sp and hm then hm.WalkSpeed=S.SpV end
    if S.Jp and hm then hm.UseJumpPower=true;hm.JumpPower=S.JpV end
    if S.Nc then for _,v in pairs(c:GetDescendants())do if v:IsA("BasePart")then v.CanCollide=false end end end
    if S.Aw and hr then
        if not AP or not AP.Parent then AP=N("Part",{Name="NAP",Size=Vector3.new(6,1,6),Anchored=true,Transparency=1,CanCollide=true,Parent=WS})end
        AP.CFrame=CFrame.new(hr.Position.X,hr.Position.Y-3.2,hr.Position.Z)
    elseif not S.Aw and AP then AP:Destroy();AP=nil end
    if S.Ka and hr then
        local tl=c:FindFirstChildOfClass("Tool")
        for _,p in pairs(PL:GetPlayers())do if p~=LP and p.Character then
            local ph=p.Character:FindFirstChild("HumanoidRootPart")
            if ph and(ph.Position-hr.Position).Magnitude<=S.KaR then
                hr.CFrame=ph.CFrame*CFrame.new(0,0,-2.5)
                if tl then pcall(function()local re=tl:FindFirstChildOfClass("RemoteEvent");if re then re:FireServer()end end)end
            end
        end end
    end
    if S.Aim then
        local cl,mn=nil,math.huge
        for _,p in pairs(PL:GetPlayers())do if p~=LP and p.Character then
            local ph=p.Character:FindFirstChild("HumanoidRootPart");local pm=p.Character:FindFirstChildOfClass("Humanoid")
            if ph and pm and pm.Health>0 then local d=(ph.Position-(hr and hr.Position or Vector3.zero)).Magnitude;if d<mn then mn=d;cl=p end end
